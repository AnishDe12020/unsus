{
  "name": "unsus",
  "version": "0.1.0",
  "private": true,
  "description": "A local package firewall for developers, CI, and AI coding agents.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/sandbox packages/cli",
    "typecheck": "tsc -b packages/core packages/sandbox packages/cli --pretty false",
    "test": "npm run build && node scripts/run-tests.mjs",
    "benchmark:synthetic": "npm run build && node scripts/benchmarks/run-synthetic-corpus.mjs",
    "samples:datadog-npm": "node scripts/research/build-datadog-npm-candidates.mjs",
    "samples:check-npm": "node scripts/research/check-npm-sample-availability.mjs",
    "lint": "tsc -b packages/core packages/sandbox packages/cli --pretty false",
    "verify:release": "npm run build && node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/semver": "^7.7.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "acorn": "^8.14.1",
    "semver": "^7.7.2",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=22"
  }
}
