{
  "name": "unsus",
  "version": "0.0.0",
  "private": true,
  "description": "A local package firewall for developers, CI, and AI coding agents.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/sandbox packages/cli",
    "typecheck": "tsc -b packages/core packages/sandbox packages/cli --pretty false",
    "test": "npm run build && node scripts/run-tests.mjs",
    "lint": "tsc -b packages/core packages/sandbox packages/cli --pretty false"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/semver": "^7.7.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "acorn": "^8.14.1",
    "semver": "^7.7.2",
    "tar": "^7.4.3"
  }
}
